# AudioVibe Foundry configuration.
#
# Copy to .env and fill in. Nothing here has a working default: every value is
# either a credential or an address, and a pipeline that publishes audio should
# fail to start rather than guess where it is publishing to.

# --- The platform ---------------------------------------------------------

# Which AudioVibe API to publish into.
#   staging    https://audiovibeserver-staging.up.railway.app
#   production https://api.audiovibe.co
#
# Note that BOTH report "environment":"production" in /api/health because
# staging's env var is unset, so never use that field to check which one you are
# pointed at. The hostname is the only reliable answer.
AUDIOVIBE_API_URL=https://audiovibeserver-staging.up.railway.app

# The show's machine publishing credential, minted on the API side with:
#   npx ts-node src/scripts/mintIngestToken.ts --username <show-handle>
#
# One per show. Bound to a single account and to the ingest scope only, so it
# cannot read messages or change account settings even if it leaks. The API
# refuses it unless that account still has is_ai set and is still a creator,
# re-checked on every request.
AUDIOVIBE_INGEST_TOKEN=

# --- Generation -----------------------------------------------------------

# The writer. Drafts scripts into beats.
ANTHROPIC_API_KEY=

# The verifier SHOULD be a different model family from the writer.
#
# Not a preference. A verifier that shares the writer's priors reconstructs the
# writer's justification instead of checking the text in front of it, which is
# the failure this whole stage exists to prevent.
OPENAI_API_KEY=

# --- Voice ----------------------------------------------------------------

# TTS. One voice is locked per show in its persona file, never here: voice is
# the show's identity to a listener, and a value that can drift by environment
# is a value that will.
ELEVENLABS_API_KEY=

# --- Behaviour ------------------------------------------------------------

# Where run artifacts are written. Relative paths resolve from the repo root.
FOUNDRY_RUNS_DIR=runs

# Hard ceiling on what one episode may cost, in pence. A run that would exceed
# it stops rather than degrading, because a cost overrun should be visible as
# silence, not as worse output.
FOUNDRY_EPISODE_BUDGET_PENCE=500
