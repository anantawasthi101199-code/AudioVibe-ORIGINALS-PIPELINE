# AudioVibe Foundry configuration.
#
# Copy to .env and fill in. Nothing here has a working default: every value is
# either a credential or an address, and a pipeline that publishes audio should
# fail to start rather than guess where it is publishing to.

# --- The platform ---------------------------------------------------------

# Which AudioVibe API to publish into.
#   staging    https://audiovibeserver-staging.up.railway.app
#   production https://api.audiovibe.co
#
# Note that BOTH report "environment":"production" in /api/health because
# staging's env var is unset, so never use that field to check which one you are
# pointed at. The hostname is the only reliable answer.
AUDIOVIBE_API_URL=https://audiovibeserver-staging.up.railway.app

# The show's machine publishing credential, minted on the API side with:
#   npx ts-node src/scripts/mintIngestToken.ts --username <show-handle>
#
# One per show. Bound to a single account and to the ingest scope only, so it
# cannot read messages or change account settings even if it leaks. The API
# refuses it unless that account still has is_ai set and is still a creator,
# re-checked on every request.
AUDIOVIBE_INGEST_TOKEN=

# --- Generation -----------------------------------------------------------

# The writer. Drafts scripts into beats.
ANTHROPIC_API_KEY=

# The verifier SHOULD be a different model family from the writer.
#
# Not a preference. A verifier that shares the writer's priors reconstructs the
# writer's justification instead of checking the text in front of it, which is
# the failure this whole stage exists to prevent.
OPENAI_API_KEY=

# Web search. The model proposes QUERIES; the search engine proposes URLs.
#
# That division is the point and not an implementation detail: a model asked for
# sources produces addresses that look exactly right and resolve to nothing,
# which is the citation hallucination the whole evidence layer is built to make
# impossible. A model never originates a URL here.
BRAVE_SEARCH_API_KEY=

# --- Voice ----------------------------------------------------------------

# TTS. One voice is locked per show in its persona file, never here: voice is
# the show's identity to a listener, and a value that can drift by environment
# is a value that will.
ELEVENLABS_API_KEY=

# Which engine renders the audio. Two engines, two jobs.
#
#   elevenlabs  publishing. Renders the whole exchange in ONE request, which is
#               where overlap, interruption and a reply that starts before the
#               last line has landed come from.
#   openai      drafting. Around fifteen pence an episode against roughly two
#               pounds. No dialogue endpoint, so turns are rendered separately
#               and joined - which sounds spliced, and that seam is the single
#               most reliable tell of generated audio.
#
# Draft on openai while you are still deciding whether the WRITING works, which
# is audible through any voice. Publish on elevenlabs. Defaults to elevenlabs
# because the safe direction for a default is the one that is right at publish
# time. Each host holds both voice ids: voiceId and draftVoiceId.
FOUNDRY_TTS=elevenlabs

# Optional: the OpenAI voice used when FOUNDRY_TTS=openai. Uses OPENAI_API_KEY.
FOUNDRY_TTS_MODEL=gpt-4o-mini-tts

# --- Behaviour ------------------------------------------------------------

# Where run artifacts are written. Relative paths resolve from the repo root.
FOUNDRY_RUNS_DIR=runs

# Where series bibles live, one JSON file per fiction show. UNLIKE runs/, these
# are committed: a run is reproducible from its inputs, a bible is the series'
# memory and losing it means every later episode contradicts freely with
# nothing to notice.
FOUNDRY_BIBLES_DIR=bibles

# Optional: which models do what.
#
# The writer and the verifier MUST be different families. A verifier sharing the
# writer's priors reconstructs the writer's justification instead of checking
# the text in front of it, which is the failure that stage exists to prevent.
#
# The clerk is a cheap model for mechanical work, currently just the
# counter-evidence search queries. The rule for what it may do is strict and
# lives in config/index.ts: only work whose output is checked by something that
# is NOT a model. Never the brief, extraction, the hook, the title,
# verification, or the series bible - those are the show.
FOUNDRY_WRITER_MODEL=claude-sonnet-5
FOUNDRY_VERIFIER_MODEL=gpt-5
FOUNDRY_CLERK_MODEL=claude-haiku-4-5

# A cheap FIRST PASS over the claims. It screens; the verifier above decides.
#
# The screen may only ever confirm a clean "entailed". Every other answer it
# gives - including one it garbles - is re-asked of the verifier, so it can
# never be the reason something wrong was published. Roughly four claims in five
# are clean, so this removes most of the verification bill without touching the
# decision on any claim that is not.
#
# Set it to an empty string to turn the screen off and send everything straight
# to the verifier.
FOUNDRY_SCREENER_MODEL=gpt-5-mini

# Hard ceiling on what one episode may cost, in pence. A run that would exceed
# it stops rather than degrading, because a cost overrun should be visible as
# silence, not as worse output.
FOUNDRY_EPISODE_BUDGET_PENCE=500

# Optional: neural search over Exa's own index. Better at "find me things ABOUT
# this" than at "find me pages containing these words", which is what a research
# brief actually needs. Pooled with Brave when both are set - they surface
# different documents and ranking downstream sorts it out.
EXA_API_KEY=

# Optional: page fetching that renders JavaScript.
#
# The one that earns its keep. The plain fetcher refuses JS-only pages as
# "a paywall or a JS shell", and on some topics that is most of the corpus. Falls
# back to the plain fetcher per URL, so running out of credit costs documents
# rather than the whole run.
FIRECRAWL_API_KEY=
