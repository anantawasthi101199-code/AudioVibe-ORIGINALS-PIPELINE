{
  "name": "audiovibe-foundry",
  "version": "0.1.0",
  "private": true,
  "description": "The AudioVibe Originals generation pipeline. Researches, writes, voices and publishes episodes as AI shows on AudioVibe.",
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc",
    "foundry": "ts-node src/cli.ts",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:ci": "eslint src --ext .ts --max-warnings 0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20"
  }
}
